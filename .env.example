# Copy to .env and fill in. NEVER commit the real .env.

# ---------- app ----------
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1

# ---------- database ----------
# local-dev defaults only. change the password before exposing this anywhere.
POSTGRES_USER=postly
POSTGRES_PASSWORD=postly
POSTGRES_DB=postly
POSTGRES_PORT=5432
# host-side URL (tools outside docker). inside compose the host is `db`.
DATABASE_URL=postgresql://postly:postly@localhost:5432/postly

# ---------- server secrets ----------
# 32+ random bytes. Used for signing session tokens and media URLs.
# generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Pepper for hashing ghost/anon ownership keys. Rotating this invalidates all ghost keys.
PEPPER=

# ---------- firebase (google sign-in) ----------
# From Firebase console > Project settings > Your apps > SDK setup
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Service account JSON, one line, or a path to the file
FIREBASE_ADMIN_CREDENTIALS=

# ---------- openai moderation (the moderation endpoint is free) ----------
OPENAI_API_KEY=
# rules -> openai -> local-hf -> none   (comma separated, first match wins)
MODERATION_CHAIN=rules,openai,local-hf

# ---------- local hf moderation worker (optional) ----------
HF_MODEL_TEXT=KoalaAI/Text-Moderation
HF_MODEL_IMAGE=Falconsai/nsfw_image_detection
HF_MODEL_MULTILINGUAL=unitary/multilingual-toxic-xlm-roberta
HF_DEVICE=cpu

# ---------- media ----------
MEDIA_ROOT=./media
MAX_UPLOAD_MB=20
SIGNED_URL_TTL_SECONDS=300

# ---------- geo ----------
GEO_DATA_SOURCE_URL=https://raw.githubusercontent.com/ghousekw/india-pincodes/master/pincode.csv
GEO_SEED_STATE=DELHI
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=Postly/0.1 (local development)

# ---------- anonymity / expiry ----------
GHOST_POST_TTL_DAYS=90
GHOST_EXPIRY_OPTIONS=7,30,90,365
GHOST_POSTS_PER_SESSION=10
GHOST_POSTS_PER_ALIAS=10

# ---------- rate limiting (rotating ip hash) ----------
RATE_LIMIT_SALT=
POSTS_PER_IP_HOUR=5
POSTS_PER_IP_DAY=20
POSTS_PER_AREA_HOUR=50
